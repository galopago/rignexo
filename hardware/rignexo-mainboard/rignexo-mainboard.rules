
(rules PCB rignexo.dsn
  (snap_angle 
    fortyfive_degree
  )
  (autoroute_settings
    (fanout off)
    (autoroute on)
    (postroute off)
    (vias on)
    (via_costs 50)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    (start_pass_no 1)
    (layer_rule F.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 3.6)
    )
    (layer_rule B.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 3.4)
    )
  )
  (rule
    (width 200.0)
    (clearance 200.2)
    (clearance 100.0 (type smd_to_turn_gap))
    (clearance 50.0 (type smd))
    (clearance 200.2 (type "kicad_default"))
  )
  (padstack "Via[0-1]_600:300_um"
    (shape
      (circle F.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 600.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_600:300_um" "Via[0-1]_600:300_um" default
  )
  (via 
    "Via[0-1]_600:300_um-kicad_default" "Via[0-1]_600:300_um" "kicad_default"
  )
  (via_rule
    default "Via[0-1]_600:300_um"
  )
  (via_rule
    "kicad_default" "Via[0-1]_600:300_um-kicad_default"
  )
  (class default
    (clearance_class default)
    (via_rule default)
    (rule
      (width 200.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class "kicad_default"
    "Net-(C1-Pad1)" "Net-(C1-Pad2)" "Net-(R1-Pad1)" "Net-(R1-Pad2)" "Net-(J1-PadS)" "Net-(C2-Pad1)" "Net-(C2-Pad2)" "Net-(J2-PadS)"
    "unconnected-(U2-5V-Pad1)" GND "unconnected-(U2-GPIO29-Pad4)" "unconnected-(U2-GPIO26-Pad7)" "unconnected-(U2-GPIO15-Pad8)" "unconnected-(U2-GPIO8-Pad10)" "unconnected-(U2-GPIO7-Pad11)" "unconnected-(U2-GPIO6-Pad12)"
    "unconnected-(U2-GPIO5-Pad13)" "unconnected-(U2-GPIO4-Pad14)" "unconnected-(U2-GPIO3-Pad15)" "unconnected-(U2-GPIO1-Pad17)" "unconnected-(U2-GPIO0-Pad18)" "Net-(C3-Pad2)" "Net-(C4-Pad1)" "Net-(C5-Pad2)"
    "Net-(D1-A)" +3.3V "Net-(R5-Pad1)" "Net-(R5-Pad2)" "Net-(C6-Pad1)" "Net-(C6-Pad2)" /PWM /ADC
    "unconnected-(K1-Pad22)" "unconnected-(K1-Pad14)" "unconnected-(K1-Pad11)" "unconnected-(K1-Pad12)" /PTT1 /PTT2 "Net-(Q1-B)" "/PTT_RELAY"
    "Net-(D4-A)" "Net-(D5-A)" "/PTT_LED"
    (clearance_class "kicad_default")
    (via_rule "kicad_default")
    (rule
      (width 200.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)