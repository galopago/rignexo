;
; Forever MODE_LED patterns (mostly ON, short OFF pulses).
; Modes 1–3: ISR = quiet-ON loops; Y = OFF and GAP (same short delay).
; Mode 4 (D34): ISR = quiet; Y = OFF; OSR = GAP (TICK − OFF). Active-high.
;

.program mode_led_1pulse
.wrap_target
    set pins, 1
    mov x, isr
on_delay:
    jmp x-- on_delay
    set pins, 0
    mov x, y
off_delay:
    jmp x-- off_delay
.wrap

.program mode_led_2pulse
.wrap_target
    set pins, 1
    mov x, isr
quiet_delay:
    jmp x-- quiet_delay
    set pins, 0
    mov x, y
off1_delay:
    jmp x-- off1_delay
    set pins, 1
    mov x, y
gap_delay:
    jmp x-- gap_delay
    set pins, 0
    mov x, y
off2_delay:
    jmp x-- off2_delay
.wrap

.program mode_led_3pulse
.wrap_target
    set pins, 1
    mov x, isr
quiet3:
    jmp x-- quiet3
    set pins, 0
    mov x, y
off3_1:
    jmp x-- off3_1
    set pins, 1
    mov x, y
gap3_1:
    jmp x-- gap3_1
    set pins, 0
    mov x, y
off3_2:
    jmp x-- off3_2
    set pins, 1
    mov x, y
gap3_2:
    jmp x-- gap3_2
    set pins, 0
    mov x, y
off3_3:
    jmp x-- off3_3
.wrap

; D34: Y = OFF width; OSR = GAP width (must remain loaded; no pull in loop).
.program mode_led_4pulse
.wrap_target
    set pins, 1
    mov x, isr
quiet4:
    jmp x-- quiet4
    set pins, 0
    mov x, y
off4_1:
    jmp x-- off4_1
    set pins, 1
    mov x, osr
gap4_1:
    jmp x-- gap4_1
    set pins, 0
    mov x, y
off4_2:
    jmp x-- off4_2
    set pins, 1
    mov x, osr
gap4_2:
    jmp x-- gap4_2
    set pins, 0
    mov x, y
off4_3:
    jmp x-- off4_3
    set pins, 1
    mov x, osr
gap4_3:
    jmp x-- gap4_3
    set pins, 0
    mov x, y
off4_4:
    jmp x-- off4_4
.wrap
